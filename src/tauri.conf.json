{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GeminUI",
  "version": "0.11.0",
  "identifier": "dev.geminui.desktop",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev:web",
      "cwd": "..",
      "wait": false
    },
    "beforeBuildCommand": {
      "script": "npm run build:web",
      "cwd": ".."
    },
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GeminUI",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "dragDropEnabled": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "devCsp": "default-src 'self' http://localhost:5173 ws://localhost:5173; connect-src 'self' http://localhost:5173 ws://localhost:5173; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": "all",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "icon": [
      "../resources/icons/png/icon-32.png",
      "../resources/icons/png/icon-128.png",
      "../resources/icons/png/icon-256.png",
      "../resources/icons/png/icon-512.png",
      "../resources/icons/png/icon-1024.png",
      "../resources/icons/geminui.icns",
      "../resources/icons/geminui.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQzMDk5NTU4RTE3QzUwMzMKUldRelVIemhXSlVKMDR4c1d2L3JiQUxWMjY2QXN6Ui90VHhuc1Rrb0NkSGUzN2g1QXRESjVJWE0K",
      "endpoints": [
        "https://github.com/bonbonn1912/gem-ui-ini/releases/latest/download/latest.json"
      ]
    }
  }
}
