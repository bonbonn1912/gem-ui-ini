{
  "name": "geminui",
  "productName": "GeminUI",
  "version": "0.9.10",
  "description": "Native multi-project desktop client for Gemini CLI",
  "main": ".vite/build/main.cjs",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "electron-forge start",
    "icons": "node scripts/build-icons.mjs",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:gemini": "node scripts/real-gemini-smoke.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && electron-forge package",
    "verify": "npm run typecheck && npm test && electron-forge package"
  },
  "author": "Dominik",
  "license": "MIT",
  "dependencies": {
    "@agentclientprotocol/sdk": "1.3.0",
    "better-sqlite3": "13.0.3",
    "electron-squirrel-startup": "1.0.1",
    "pdfjs-dist": "^6.2.108",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-deb": "7.11.2",
    "@electron-forge/maker-rpm": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron/fuses": "1.8.0",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.5",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "electron": "43.4.1",
    "jsdom": "29.1.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
